{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <h1>Dashboard administrateur</h1>

    <div style="display: flex; gap: 20px; margin-top: 20px;">
        <div class="card">
            <h3>Salles</h3>
            <p>Gérer les salles disponibles</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\SalleCrudController').generateUrl() }}">
                Accéder
            </a>
        </div>

        <div class="card">
            <h3>Événements</h3>
            <p>Gérer les événements</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\EvenementCrudController').generateUrl() }}">
                Accéder
            </a>
        </div>

        <div class="card">
            <h3>Utilisateurs</h3>
            <p>Gestion des comptes</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">
                Accéder
            </a>
        </div>
    </div>
{% endblock %}
