{% extends 'base.html.twig' %}

{% block title %}Evenement{% endblock %}

{% block body %}
    <h1>Evenement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Titre</th>
                <td>{{ evenement.titre }}</td>
            </tr>
            <tr>
                <th>DateEvenement</th>
                <td>
                    {% set reservation = evenement.reservations|first %}
                    {% if reservation %}
                        {{ reservation.dateDebut|date('Y-m-d H:i') }}
                        →
                        {{ reservation.dateFin|date('Y-m-d H:i') }}
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    {% if app.user and evenement.responsable != app.user %}
        <a href="{{ path('app_avis_new', { id: evenement.id }) }}">
            Donner un avis
        </a>
    {% endif %}

    <h3>Avis</h3>

    {% for avis in avis %}
        {% if avis.accepte %}
            <p>
                ⭐ {{ avis.note }}/5<br>
                {{ avis.commentaire }}
            </p>
        {% endif %}
    {% else %}
        <p>Aucun avis pour le moment.</p>
    {% endfor %}

    <a href="{{ path('app_evenement_index') }}">back to list</a>

    <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}">edit</a>

    {{ include('evenement/_delete_form.html.twig') }}
{% endblock %}
